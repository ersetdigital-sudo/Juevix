# Domain final situs (tanpa trailing slash). Dipakai untuk canonical, Open Graph, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://juevix.id

# Nomor WhatsApp CS, format internasional tanpa "+" (contoh: 628123456789).
# Biarkan kosong untuk menyembunyikan tombol WhatsApp.
NEXT_PUBLIC_WHATSAPP=

# Email customer service. Biarkan kosong untuk menyembunyikan tautan email.
NEXT_PUBLIC_EMAIL=
